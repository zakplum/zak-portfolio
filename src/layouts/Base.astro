---
import '../styles/global.css';
const {title='Zak Plumridge — Data, software & useful things',description='A portfolio of data science, software and practical tools by Zak Plumridge.'}=Astro.props;
const origin='https://zak-portfolio-sable.vercel.app';
const canonical=new URL(Astro.url.pathname,origin).href;
const pageSlug=Astro.url.pathname.split('/').filter(Boolean).pop()||'home';
const slug=['about','radar','indy','cosmos','fair-play'].includes(pageSlug)?pageSlug:'home';
const image=new URL(`/og/${slug}.png`,origin).href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#fffffc"/><title>{title}</title><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Zak Plumridge"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`${title} — Zak Plumridge portfolio`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body><a href="#main" class="skip">Skip to content</a><header class="site-header shell"><a href="/" class="logo" aria-label="Zak home">zak<span>.</span></a><nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/about/">About</a><a href="https://linkedin.com/in/zakplumridge" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">→</span></a><a href="https://github.com/zakplum" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">→</span></a></nav><span class="availability"><i></i> Open to opportunities</span></header><main id="main"><slot/></main><footer class="site-footer shell"><a href="/" class="logo" aria-label="Zak home">zak<span>.</span></a><span>Good questions. Thoughtful work.</span><div><a href="/downloads/zak-plumridge-cv.pdf" download>Download CV (PDF)</a><a href="mailto:zakplumridge@outlook.com">Email</a><a href="https://linkedin.com/in/zakplumridge" target="_blank" rel="noopener noreferrer">LinkedIn →</a><a href="https://github.com/zakplum" target="_blank" rel="noopener noreferrer">GitHub →</a></div><small>© {new Date().getFullYear()} Zak Plumridge</small></footer></body></html>
