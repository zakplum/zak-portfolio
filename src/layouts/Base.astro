---
import '../styles/global.css';
import {getCollection} from 'astro:content';
const projectCount=(await getCollection('projects')).length;
const {title='Zak Plumridge — Data, software & useful things',description='A portfolio of data science, software and practical tools by Zak Plumridge.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#161510"/><title>{title}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body><a href="#main" class="skip">Skip to content</a><header class="site-header shell"><a href="/" class="logo" aria-label="Zak home">zak<span>.</span></a><nav aria-label="Main navigation"><a href="/#work">Work <sup>{String(projectCount).padStart(2,'0')}</sup></a><a href="/#about">About</a><a href="https://linkedin.com/in/zakplumridge" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">→</span></a><a href="https://github.com/zakplum" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">→</span></a></nav><span class="availability"><i></i> Open to opportunities</span></header><main id="main"><slot/></main><footer class="site-footer shell"><a href="/" class="logo" aria-label="Zak home">zak<span>.</span></a><span>Good questions. Thoughtful work.</span><div><a href="https://linkedin.com/in/zakplumridge" target="_blank" rel="noopener noreferrer">LinkedIn →</a><a href="https://github.com/zakplum" target="_blank" rel="noopener noreferrer">GitHub →</a></div><small>© {new Date().getFullYear()} Zak Plumridge</small></footer></body></html>
