---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {getCollection} from 'astro:content';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<Base><section class="intro shell"><p class="eyebrow centred">DATA SCIENCE / SOFTWARE / CURIOSITY</p><div class="intro-row"><h1>Hi, I’m Zak<span class="blue">.</span></h1><p>I work with data, build software,<br/>and turn ideas into useful tools.</p></div><div class="intro-foot"><a href="#work">Explore my work <span aria-hidden="true">↓</span></a></div></section><section id="work" class="work shell"><div class="section-line"><h2 class="eyebrow">SELECTED WORK <span class="quiet">/ {String(projects.length).padStart(2,'0')} PROJECTS</span></h2><div class="filters" aria-label="Filter projects">{['All work','Data science','Software','Business tools'].map((f,i)=><button class:list={['filter',{'selected':i===0}]} data-filter={i===0?'all':f} aria-pressed={i===0}>{f}</button>)}</div></div><p class="sr-only" id="filter-count" aria-live="polite">Showing all {projects.length} projects</p><div class="project-grid">{projects.map(p=><ProjectCard project={p.data}/>)}</div></section><section id="about" class="about shell"><div><p class="eyebrow">A LITTLE ABOUT ME</p><h2>A curious mind.<br/>A practical approach.</h2></div><div><p>I’m Zak Plumridge. My work spans data science, software development and tools that help people make sense of information.</p><p>I bring professional experience in building data-driven applications, alongside an MSc in Data Science from the University of Sussex and a BSc in Computer Science from Goldsmiths, University of London.</p><div class="about-links"><a class="button primary" href="https://linkedin.com/in/zakplumridge" target="_blank" rel="noopener noreferrer">Let’s connect on LinkedIn →</a><a href="https://github.com/zakplum" target="_blank" rel="noopener noreferrer">See my GitHub →</a></div></div></section></Base>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;let count=0;buttons.forEach(b=>{const selected=b===button;b.classList.toggle('selected',selected);b.setAttribute('aria-pressed',String(selected));});document.querySelectorAll<HTMLElement>('[data-areas]').forEach(card=>{const visible=filter==='all'||card.dataset.areas?.split('|').includes(filter||'');card.hidden=!visible;if(visible)count++;});const status=document.getElementById('filter-count');if(status)status.textContent=`Showing ${count} projects`; }));
</script>
