---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Artwork from '../../components/Artwork.astro';
import FairPlay from '../../components/FairPlay';
import Radar from '../../components/Radar';
import Indy from '../../components/Indy';
import Cosmos from '../../components/Cosmos';
export async function getStaticPaths(){const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);return projects.map((p,i)=>({params:{slug:p.data.slug},props:{project:p.data,next:projects[(i+1)%projects.length].data}}));}
const {project:p,next}=Astro.props;
const hasInteraction=['fair-play','radar','indy','cosmos'].includes(p.slug);
---
<Base title={`${p.title} — Zak Plumridge`} description={p.summary}><div class="shell"><a class="back-link" href="/#work">← All projects</a><section class="case-hero"><div><p class="eyebrow">0{p.order} / {p.category.toUpperCase()}</p><h1>{p.title}<span class="blue">.</span></h1><p class="case-subtitle">{p.subtitle}</p><ul class="stack">{p.stack.map(t=><li>{t}</li>)}</ul><a class="button primary" href={hasInteraction?'#explore':'#story'}>Explore the project ↓</a></div><div class="case-art"><Artwork kind={p.slug}/></div></section><div class="case-meta"><div><span class="micro">CONTEXT</span><p>{p.context}</p></div><div><span class="micro">MY ROLE</span><p>{p.role}</p></div><div><span class="micro">ON THIS PAGE</span><nav aria-label="Project sections"><a href="#story">The problem</a>{hasInteraction&&<a href="#explore">Explore</a>}<a href="#decisions">Decisions</a><a href="#evidence">Evidence</a></nav></div></div><section id="story" class="story"><div><p class="eyebrow">01 / THE QUESTION</p><h2>{p.slug==='fair-play'?'Harmful content stays visible too long.':p.slug==='radar'?'Make scattered information actionable.':p.slug==='indy'?'Bring a place into focus.':'Learning from the unseen.'}</h2></div><div><p class="lead">{p.problem}</p><h3>My contribution</h3><p>{p.contribution}</p>{p.reportSections&&<div class="report-outline"><h3>Inside the report</h3>{p.reportSections.map(section=><div><h3>{section.title}</h3><p>{section.body}</p></div>)}</div>}</div></section>{hasInteraction&&<section id="explore" class="explore"><p class="eyebrow">02 / GET A FEEL FOR IT</p><div class="section-intro"><h2>{p.interactionTitle}</h2><p>{p.interactionIntro}</p></div>{p.slug==='fair-play'?<FairPlay client:load/>:p.slug==='radar'?<Radar client:load/>:p.slug==='indy'?<Indy client:load/>:<Cosmos client:load/>}<noscript><p>Enable JavaScript to explore this demonstration. The project story, decisions and evidence remain available below.</p></noscript></section>}<section id="decisions" class="decisions"><div><p class="eyebrow">03 / HOW I APPROACHED IT</p><h2>The decisions<br/>behind the work.</h2></div><div class="decision-list">{p.decisions.map((d,i)=><details open={i===0}><summary><span>0{i+1}</span>{d.title}<b aria-hidden="true">+</b></summary><p>{d.body}</p></details>)}</div></section><section id="evidence" class="evidence"><div><p class="eyebrow">04 / THE FULL PICTURE</p><h2>Evidence &amp;<br/>limitations.</h2></div><div><h3>What this shows</h3><p>{p.evidence}</p><h3>What to keep in mind</h3><p>{p.limitations}</p>{p.links.length>0&&<div class="resource-links">{p.links.map(l=><a class="button secondary" href={l.url} target="_blank" rel="noopener noreferrer">{l.label} →</a>)}</div>}</div></section><a class="next-project" href={`/projects/${next.slug}/`}><div><span class="eyebrow">ANOTHER SIDE OF MY WORK</span><h2>{next.title}</h2><p>{next.category}</p></div><span class="next-arrow" aria-hidden="true">→</span></a></div></Base>
