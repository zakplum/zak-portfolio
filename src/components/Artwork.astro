---
const {kind}=Astro.props;
const dots=Array.from({length:340},(_,i)=>{const t=i*2.39996,r=Math.sqrt((i+.5)/340);return {x:330+Math.cos(t)*r*220,y:180+Math.sin(t*2)*r*140,size:((i*7)%12)/10+.6};});
---
<div class:list={['artwork',`art-${kind}`]} aria-hidden="true">
{kind==='fair-play'&&<><div class="pitch"><div></div><i></i><b></b></div><div class="speech speech-one"><span class="avatar">01</span><div>“What a finish. Unbelievable.”<small>MATCH THREAD / COMMENT</small></div><span class="comment-dot"></span></div><div class="speech speech-two"><span class="avatar">02</span><div>Spot harm.<br/>Respond sooner.<small>FASTER MODERATION</small></div><span class="review-mark">?</span></div><div class="art-caption">LESS TIME VISIBLE. LESS EXPOSURE.</div></>}
{kind==='radar'&&<><div class="radar-orbit"><span></span><span></span><span></span><i class="radar-sweep"></i><b class="blip b1"></b><b class="blip b2"></b><b class="blip b3"></b></div><div class="record-float"><small>OPPORTUNITY IDENTIFIED</small><strong>Meadow Fields</strong><span>148 homes <i>→</i> Ready for review</span><div class="record-progress"><i></i><i></i><i></i><i></i></div></div><div class="art-caption">DISCOVER. ENRICH. REVIEW.</div></>}
{kind==='cosmos'&&<><svg class="cosmic-field" viewBox="0 0 600 360" preserveAspectRatio="xMidYMid slice">{dots.map(d=><circle cx={d.x} cy={d.y} r={d.size} fill="#2fb9ff" opacity=".7"/>)}<circle cx="400" cy="113" r="28" fill="none" stroke="#f9f9f7" stroke-opacity=".3"/><circle cx="298" cy="202" r="15" fill="none" stroke="#f9f9f7" stroke-opacity=".3"/></svg><div class="cosmos-title">Beyond<br/><em>the visible.</em></div><div class="art-caption">21 cm / A QUESTION OF SPACE</div></>}
{kind==='indy'&&<><svg class="map-art" viewBox="0 0 600 360" preserveAspectRatio="xMidYMid slice"><path d="M0 65L600 260M0 210L600 80M100 0L380 360M430 0L170 360M0 320L600 140" stroke="#f9f9f7" stroke-width="17" fill="none"/><path d="M260 -40Q500 160 330 390" stroke="#2fb9ff" stroke-width="42" fill="none"/><path d="M260 -40Q500 160 330 390" stroke="#9cddff" stroke-width="1" fill="none"/></svg><span class="place-pin">+</span><div class="insight-float"><small>WILLOWFORD / FICTIONAL PLACE</small><strong>A place.<br/>A clearer picture.</strong><div class="art-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div><span>Every insight has a source.</span></div><div class="art-caption">CONTEXT, CONNECTED.</div></>}
{!['fair-play','radar','cosmos','indy'].includes(kind)&&<div class="generic-art"><span>FROM QUESTION</span><strong>To possibility.</strong><span>EXPLORE THE PROJECT</span></div>}
</div>
